CompileFlags:
  Add:
    - -std=c++20
    - -Wall
    - -Wextra
    # Explicit gcc 11 system header paths. Without these, clangd's
    # bundled clang frontend can't find <memory>, <cstddef>, etc.
    - -isystem/usr/include/c++/11
    - -isystem/usr/include/x86_64-linux-gnu/c++/11
    - -isystem/usr/include/c++/11/backward
    - -isystem/usr/lib/gcc/x86_64-linux-gnu/11/include
    - -isystem/usr/local/include
    - -isystem/usr/include/x86_64-linux-gnu
    - -isystem/usr/include
  CompilationDatabase: build

Diagnostics:
  Suppress:
    - -Wunused-parameter

Index:
  Background: Build
  StandardLibrary: Yes
